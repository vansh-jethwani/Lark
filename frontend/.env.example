# Lark - copy to backend/.env (and mirror in the Render dashboard).
# Never commit a real .env file.

# --- core ---
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb+srv://user:password@cluster/db?retryWrites=true&w=majority
JWT_SECRET=long-random-string-min-32-chars

# --- urls ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
# CLIENT_URL is a legacy alias of FRONTEND_URL.
# REDIS_URL enables the multi-instance socket adapter (optional).

# --- chat media (ImageKit) ---
IMAGEKIT_PRIVATE_KEY=imagekit-private-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id

# --- push notifications (web-push / VAPID) ---
VAPID_PUBLIC_KEY=vapid-public-key
VAPID_PRIVATE_KEY=vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# --- email (Resend, for OTP mails) ---
RESEND_API_KEY=resend-api-key
RESEND_FROM_EMAIL=Lark noreply@example.com
# OTP_HASH_SECRET is optional; falls back to JWT_SECRET.

# --- frontend (frontend/.env or Render env vars; VITE_ prefix required) ---
# VITE_API_URL=                  # empty = same-origin /api (recommended on Render)
